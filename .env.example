# Neon pooled connection string (use the "pooled" host, ends with -pooler)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Cloudinary (the API secret must only live in Render's env vars, never in git)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, dev only: allow API calls from another origin (comma-separated).
# Leave unset on Render (the app and API are same-origin) and normally in dev too (Vite proxies /api).
# CLIENT_ORIGIN=http://localhost:5173
